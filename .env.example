# Copy to .env for local runs. .env is gitignored and never uploaded to Modal.
# Every key is optional: without any, the app runs offline (rules + templates).

# Default provider shown in the sidebar: openrouter | claude | kimi | mock
LLM_MODE=openrouter
LLM_TIMEOUT_S=30
LLM_DAILY_CAP=200

# --- OpenRouter (default; free Nemotron model) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_REASONING=true

# --- Claude (Anthropic) - optional ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# --- Kimi (Moonshot) - optional ---
MOONSHOT_API_KEY=
# International: https://api.moonshot.ai/v1   China: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# --- Query guard rails ---
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_S=5
